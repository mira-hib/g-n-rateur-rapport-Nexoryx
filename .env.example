# ==========================================
# CONFIGURATION DU PROVIDER IA
# ==========================================
# Provider à utiliser: openai, gemini, claude, zephyr
AI_PROVIDER=gemini

# ==========================================
# CLÉS API (configurer selon le provider choisi)
# ==========================================

# OpenAI (GPT-4, GPT-4 Turbo, etc.)
OPENAI_API_KEY=sk-...

# Google Gemini (Gemini Pro, Gemini Flash)
GEMINI_API_KEY=AI...

# Anthropic Claude (Claude 3.5 Sonnet, Claude 3 Opus, etc.)
ANTHROPIC_API_KEY=sk-ant-...

# HuggingFace (pour Zephyr et autres modèles open-source)
HUGGINGFACE_API_KEY=hf_...

# ==========================================
# MODÈLES PAR PROVIDER
# ==========================================

# OpenAI
OPENAI_MODEL=gpt-4o
# Autres options: gpt-4-turbo, gpt-3.5-turbo

# Google Gemini
GEMINI_MODEL=gemini-1.5-pro
# Autres options: gemini-1.5-flash, gemini-pro

# Anthropic Claude
CLAUDE_MODEL=claude-3-5-sonnet-20241022
# Autres options: claude-3-opus-20240229, claude-3-sonnet-20240229

# Zephyr (HuggingFace)
ZEPHYR_MODEL=HuggingFaceH4/zephyr-7b-beta
# Autres options: HuggingFaceH4/zephyr-7b-alpha

# ==========================================
# PARAMÈTRES DE GÉNÉRATION
# ==========================================

# Température de génération (0.0 = déterministe, 1.0 = créatif)
TEMPERATURE=0.3

# Nombre maximum de tokens par réponse
MAX_TOKENS=16000

# Nombre maximum d'itérations de correction
MAX_ITERATIONS=3

# Score minimum de validation (0-100)
MIN_VALIDATION_SCORE=75.0

# ==========================================
# ACTIVATION DES FONCTIONNALITÉS
# ==========================================

# Activer l'enrichissement IA
ENABLE_ENRICHMENT=true

# Activer la validation automatique
ENABLE_VALIDATION=true

# Activer le checkpointing LangGraph
CHECKPOINT_ENABLED=true
